# Copy to .env locally. Do not commit actual secrets.
CAIXA_DB_PATH=./data/caixa.sqlite3
CAIXA_TOKEN_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
CAIXA_BOOTSTRAP_SECRET=replace-with-a-different-long-random-secret-at-least-32-bytes
CAIXA_TOKEN_TTL_SECONDS=28800
CAIXA_PUBLIC_SIGNUP=false
CAIXA_DEMO_MODE=false
# Comma-separated trusted browser origins, if using a separate frontend.
CAIXA_ALLOWED_ORIGINS=
